# Copy to .env and fill in. Every value below has a working local default or a
# graceful fallback, so an empty .env still runs the whole stack on a laptop.

# ── Runtime ────────────────────────────────────────────────────────────────
ENV=development
LOG_LEVEL=INFO

# ── MongoDB Atlas ──────────────────────────────────────────────────────────
# Atlas > Connect > Drivers. Network Access must allow 0.0.0.0/0 for Render.
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=nice_plates

# ── Redis / Render Key Value ───────────────────────────────────────────────
# Without this the worker falls back to a 30s Mongo sweep. Nothing breaks.
REDIS_URL=redis://localhost:6379/0
# Free Render has no worker service type, so the API hosts the worker loop.
EMBEDDED_WORKER=true

# ── Google sign-in ─────────────────────────────────────────────────────────
# console.cloud.google.com > Credentials > OAuth client ID > Web application.
# Authorized JavaScript origins: http://localhost:5173 + your Vercel URL.
# No redirect URI needed — we use the GIS ID-token flow.
GOOGLE_CLIENT_ID=

# ── Session tokens ─────────────────────────────────────────────────────────
# openssl rand -hex 32
JWT_SECRET=dev-only-insecure-change-me

# ── Cloudflare R2 ──────────────────────────────────────────────────────────
# Leave blank to store uploads on local disk instead.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=nice-plates
R2_PUBLIC_BASE_URL=

# ── Coach (OpenAI) ─────────────────────────────────────────────────────────
# platform.openai.com > API keys
OPENAI_API_KEY=
# Cheap tier. Any function-calling model works if you want to trade up.
COACH_MODEL=gpt-4o-mini

# ── CORS ───────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
